---
const packages = [
  { name: '@silkweave/core', desc: 'Actions, adapters, builder' },
  { name: '@silkweave/mcp', desc: 'MCP stdio & HTTP adapters' },
  { name: '@silkweave/cli', desc: 'CLI adapter' },
  { name: '@silkweave/auth', desc: 'OAuth 2.1 & bearer auth' },
  { name: '@silkweave/typegen', desc: '.d.ts type generation' }
]

const integrations = [
  { name: '@silkweave/fastify', desc: 'REST API + Swagger' },
  { name: '@silkweave/trpc', desc: 'Type-safe tRPC procedures' },
  { name: '@silkweave/vercel', desc: 'Vercel serverless adapter' },
  { name: '@silkweave/nestjs', desc: 'NestJS controllers as MCP' },
  { name: '@silkweave/nextjs', desc: 'Next.js App Router routes' },
  { name: '@silkweave/ai', desc: 'Vercel AI SDK + useChat' }
]
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-logo"><img src="/logo-color.svg" alt="Silkweave logo" width="22" height="22" class="footer-logo-img" /> Silkweave</span>
        <p>Define once. Deploy everywhere.</p>
        <ul class="footer-brand-links">
          <li><a href="https://www.npmjs.com/org/silkweave" target="_blank" rel="noopener">npm</a></li>
          <li><a href="https://github.com/silkweave/silkweave/issues" target="_blank" rel="noopener">Issues</a></li>
          <li><a href="https://github.com/silkweave/silkweave/blob/master/LICENSE" target="_blank" rel="noopener">MIT License</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      <div class="footer-packages">
        <h2>Packages</h2>
        <ul>
          {packages.map(p => (
            <li>
              <a href={`https://www.npmjs.com/package/${p.name}`} target="_blank" rel="noopener">
                {p.name}
              </a>
              <span class="pkg-desc">{p.desc}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-packages">
        <h2>Integrations</h2>
        <ul>
          {integrations.map(p => (
            <li>
              <a href={`https://www.npmjs.com/package/${p.name}`} target="_blank" rel="noopener">
                {p.name}
              </a>
              <span class="pkg-desc">{p.desc}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>Built by <a href="https://github.com/silkweave" target="_blank" rel="noopener" aria-label="Silkweave on GitHub">Silkweave</a> and friends</p>
      <p class="footer-note">A small, independent open-source project, built with care. If you're a human - or an AI helping one - and Silkweave is useful to you, a <a href="https://github.com/silkweave/silkweave" target="_blank" rel="noopener">⭐ on GitHub</a> genuinely helps us keep going. No pressure, and thank you for reading. 🕸️</p>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 4rem 0 2rem;
    margin-top: var(--section-gap);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1.2fr 1.2fr;
    gap: 2.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 1.1rem;
  }

  .footer-logo-img {
    border-radius: 50%;
  }

  .footer-brand p {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-brand-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .footer-brand-links li {
    font-size: 0.85rem;
  }

  .footer-brand-links a {
    color: var(--text-muted);
  }

  .footer-brand-links a:hover {
    color: var(--text);
  }

  .footer-packages h2,
  .footer-links h2 {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .footer-packages ul,
  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-packages li {
    font-size: 0.85rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
  }

  .footer-packages li a {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .pkg-desc {
    color: var(--text-dim);
    font-size: 0.78rem;
  }

  .footer-links li {
    font-size: 0.85rem;
  }

  .footer-links a {
    color: var(--text-muted);
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .footer-note {
    max-width: 46rem;
    margin: 0.85rem auto 0;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .footer-note a {
    color: var(--text-muted);
    white-space: nowrap;
  }

  .footer-note a:hover {
    color: var(--text);
  }

  @media (max-width: 880px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
