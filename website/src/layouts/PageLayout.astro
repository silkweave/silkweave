---
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import Layout from './Layout.astro'

interface Props {
  title: string
  description: string
  slug: string
  eyebrow: string
  heading: string
  intro: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const { title, description, slug, eyebrow, heading, intro, jsonLd } = Astro.props
---

<Layout title={`${title} - Silkweave`} description={description} slug={slug} jsonLd={jsonLd}>
  <Nav />
  <main class="page">
    <div class="page-glow" aria-hidden="true"></div>
    <div class="page-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>{eyebrow}</span>
      </nav>
      <header class="page-header">
        <p class="section-label">{eyebrow}</p>
        <h1 set:html={heading} />
        <p class="lede">{intro}</p>
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page {
    position: relative;
    overflow: hidden;
  }

  /* Soft accent glow behind the header, echoing the landing hero */
  .page-glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 1100px;
    height: 700px;
    background:
      radial-gradient(600px 380px at 50% 0%, rgba(123, 126, 245, 0.16), transparent 70%),
      radial-gradient(420px 320px at 80% 10%, rgba(103, 232, 249, 0.08), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Match the homepage/nav .container so content aligns with the logo */
  .page-inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 7rem 1.5rem 5rem;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 2rem;
  }

  .crumbs a {
    color: var(--text-muted);
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .page-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .section-label {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: var(--accent-bg);
    border: 1px solid rgba(123, 126, 245, 0.2);
    padding: 0.3rem 0.85rem;
    border-radius: 100px;
    margin-bottom: 1.5rem;
  }

  .page-header h1 {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin-bottom: 1.5rem;
  }

  .page-header :global(.grad) {
    background: linear-gradient(135deg, var(--accent) 0%, #a78bfa 50%, #67e8f9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lede {
    font-size: 1.25rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 680px;
  }

  /* ── prose ────────────────────────────────────────────────── */
  .prose {
    line-height: 1.8;
    color: var(--text);
  }

  .prose :global(h2) {
    font-size: 1.7rem;
    font-weight: 700;
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    line-height: 1.22;
    letter-spacing: -0.02em;
    scroll-margin-top: 5rem;
  }

  .prose :global(h3) {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
    color: var(--text-muted);
  }

  .prose :global(.lead-p) {
    font-size: 1.1rem;
    color: var(--text);
  }

  .prose :global(ul:not(.dd-cards):not(.next-links)) {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
    list-style: none;
  }

  .prose :global(ul:not(.dd-cards):not(.next-links) > li) {
    margin-bottom: 0.6rem;
    position: relative;
    padding-left: 1rem;
    color: var(--text-muted);
  }

  .prose :global(ul:not(.dd-cards):not(.next-links) > li::before) {
    content: '·';
    position: absolute;
    left: -0.25rem;
    color: var(--accent);
    font-weight: 700;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgba(123, 126, 245, 0.4);
  }

  .prose :global(a:hover) {
    color: var(--accent-hover);
    text-decoration-color: var(--accent-hover);
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--text);
  }

  .prose :global(:not(pre) > code) {
    background: var(--accent-bg);
    color: var(--text);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.85em;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  .prose :global(pre) {
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.7;
    margin: 1.5rem 0;
    tab-size: 2;
  }

  .prose :global(pre code) {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    background: none;
    padding: 0;
    color: var(--text);
  }

  /* ── card grid ────────────────────────────────────────────── */
  .prose :global(.dd-cards) {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  /* Tighter min so four peer cards sit on one row at desktop width */
  .prose :global(.dd-cards-quad) {
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  }

  .prose :global(.dd-card-logo) {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    margin: 0 0 0.9rem;
    flex-shrink: 0;
  }

  /* The Vercel mark is a currentColor (black) triangle - invert it to white
     so it reads on the dark card, matching Vercel's own dark-mode treatment. */
  .prose :global(.dd-card-logo-invert) {
    filter: invert(1);
  }

  /* Grid cells stretch so a card (whether the <li> itself or an <a> inside it)
     fills the cell to equal heights. */
  .prose :global(.dd-cards > li) {
    display: flex;
    margin: 0;
  }

  /* Only zero out the wrapper <li> when the card is an inner <a>; a bare
     li.dd-card keeps its own padding. */
  .prose :global(.dd-cards > li:not(.dd-card)) {
    padding: 0;
  }

  .prose :global(.dd-cards > li::before) {
    content: none;
  }

  .prose :global(.dd-card) {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .prose :global(.dd-card::before) {
    content: none;
  }

  .prose :global(a.dd-card:hover) {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .prose :global(.dd-card .dd-num) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--accent-bg);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.85rem;
  }

  .prose :global(.dd-card h3),
  .prose :global(.dd-card .dd-card-title) {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
  }

  .prose :global(.dd-card p) {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .prose :global(.dd-card .dd-tag) {
    align-self: flex-start;
    margin-top: 0.85rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.15rem 0.5rem;
  }

  .prose :global(.dd-card .dd-card-link) {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  /* ── callout / info box ───────────────────────────────────── */
  .prose :global(.callout) {
    display: flex;
    gap: 0.9rem;
    margin: 1.75rem 0;
    padding: 1.1rem 1.35rem;
    background: var(--accent-bg);
    border: 1px solid rgba(123, 126, 245, 0.22);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
  }

  .prose :global(.callout.tip) {
    background: rgba(34, 197, 94, 0.07);
    border-color: rgba(34, 197, 94, 0.25);
    border-left-color: var(--success);
  }

  .prose :global(.callout .callout-icon) {
    flex-shrink: 0;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .prose :global(.callout p) {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text);
  }

  /* ── cross-link cards at page foot ────────────────────────── */
  .prose :global(.next-links) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 3.5rem;
    padding: 0;
    list-style: none;
  }

  .prose :global(.next-links li) {
    margin: 0;
    padding: 0;
  }

  .prose :global(.next-links a) {
    display: block;
    height: 100%;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    transition: border-color 0.15s, transform 0.15s;
  }

  .prose :global(.next-links a span) {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-dim);
  }

  .prose :global(.next-links a:hover) {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2.1rem;
    }

    .lede {
      font-size: 1.1rem;
    }
  }
</style>
