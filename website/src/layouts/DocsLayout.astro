---
import Layout from './Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title?: string
  description?: string
  slug?: string
}

const {
  title = 'Documentation - Silkweave',
  description = 'Silkweave documentation - actions, adapters, and integrations for building MCP servers and CLI tools from a single set of Actions.',
  slug = 'docs'
} = Astro.props

const siteUrl = 'https://www.silkweave.dev'
const pageUrl = `${siteUrl}/${slug}`

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    url: pageUrl,
    author: { '@type': 'Organization', name: 'Silkweave', url: 'https://github.com/silkweave' },
    publisher: {
      '@type': 'Organization',
      name: 'Silkweave',
      logo: { '@type': 'ImageObject', url: `${siteUrl}/logo-color.svg` }
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Docs', item: `${siteUrl}/docs` }
    ]
  }
]

const sections = [
  { id: 'getting-started', label: 'Getting Started', children: [
    { id: 'installation', label: 'Installation' },
    { id: 'quick-start', label: 'Quick Start' }
  ]},
  { id: 'core-concepts', label: 'Core Concepts', children: [
    { id: 'actions', label: 'Actions' },
    { id: 'adapters', label: 'Adapters' },
    { id: 'context', label: 'Context & DI' },
    { id: 'streaming', label: 'Streaming Actions' }
  ]},
  { id: 'adapter-reference', label: 'Adapter Reference', children: [
    { id: 'adapter-mcp-stdio', label: 'MCP (stdio)' },
    { id: 'adapter-mcp-http', label: 'MCP (HTTP)' },
    { id: 'adapter-fastify', label: 'Fastify REST' },
    { id: 'rest-routing', label: 'REST routing' },
    { id: 'adapter-trpc', label: 'tRPC' },
    { id: 'adapter-cli', label: 'CLI' },
    { id: 'adapter-edge', label: 'Edge / Serverless' },
    { id: 'adapter-typegen', label: 'Type Generation' }
  ]},
  { id: 'integrations', label: 'Integrations', children: [
    { id: 'integration-standalone', label: 'Standalone' },
    { id: 'integration-nestjs', label: 'NestJS' },
    { id: 'integration-nextjs', label: 'Next.js' },
    { id: 'integration-ai-sdk', label: 'Vercel AI SDK' }
  ]},
  { id: 'smart-tool-results', label: 'Smart Tool Results', children: [
    { id: 'custom-tool-result', label: 'Custom toolResult Hook' },
    { id: 'result-utilities', label: 'Result Utilities' }
  ]},
  { id: 'authentication', label: 'Authentication', children: [
    { id: 'bearer-token', label: 'Bearer Token' },
    { id: 'oauth', label: 'OAuth 2.1' },
    { id: 'per-action-guards', label: 'Per-Action Guards' }
  ]},
  { id: 'error-handling', label: 'Error Handling', children: [
    { id: 'silkweave-error', label: 'SilkweaveError' },
    { id: 'adapter-error-behavior', label: 'Adapter Behavior' }
  ]},
  { id: 'testing', label: 'Testing', children: [
    { id: 'unit-testing', label: 'Unit Testing Actions' }
  ]},
  { id: 'escape-hatches', label: 'Escape Hatches', children: [
    { id: 'native-objects', label: 'Accessing Native Objects' },
    { id: 'context-by-adapter', label: 'Context by Adapter' }
  ]}
]
---

<Layout title={title} description={description} slug={slug} jsonLd={jsonLd}>
  <Nav />
  <div class="docs-wrapper">
    <aside class="docs-sidebar">
      <details class="docs-toc">
        <summary class="docs-toc-summary">
          <span>On this page</span>
          <svg class="docs-toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <nav class="docs-nav">
          {sections.map(section => (
            <div class="nav-group">
              <a href={`#${section.id}`} class="nav-group-title">{section.label}</a>
              <ul>
                {section.children.map(child => (
                  <li><a href={`#${child.id}`} class="nav-link" data-section={child.id}>{child.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </details>
    </aside>
    <main class="docs-content">
      <slot />
    </main>
  </div>
  <Footer />
</Layout>

<style>
  .docs-wrapper {
    display: flex;
    max-width: 1100px;
    margin: 0 auto;
    padding: 6rem 1.5rem 0;
    gap: 3rem;
  }

  .docs-sidebar {
    position: sticky;
    top: 5rem;
    width: 220px;
    flex-shrink: 0;
    height: calc(100vh - 5rem);
    overflow-y: auto;
    padding: 1rem 0;
  }

  .docs-sidebar::-webkit-scrollbar {
    width: 4px;
  }

  .docs-sidebar::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 2px;
  }

  .docs-content {
    flex: 1;
    min-width: 0;
    padding-bottom: 4rem;
  }

  /* Desktop: force the <details> TOC always-open. Closed <details> hides content
     via `display:none` (Firefox/Safari) or `::details-content` (Chrome) - override both. */
  @media (min-width: 861px) {
    .docs-toc-summary {
      display: none;
    }

    .docs-toc > .docs-nav {
      display: block !important;
    }

    .docs-toc::details-content {
      content-visibility: visible !important;
    }
  }

  .nav-group {
    margin-bottom: 1.25rem;
  }

  .nav-group-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
    padding: 0.2rem 0;
  }

  .nav-group-title:hover {
    color: var(--text);
  }

  .nav-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    display: block;
    font-size: 0.85rem;
    color: var(--text-dim);
    padding: 0.2rem 0 0.2rem 0.75rem;
    border-left: 2px solid transparent;
    transition: all 0.15s;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  @media (max-width: 860px) {
    .docs-wrapper {
      flex-direction: column;
      padding-top: 5rem;
      gap: 1.5rem;
    }

    .docs-sidebar {
      position: relative;
      top: 0;
      width: 100%;
      height: auto;
      overflow: visible;
      padding: 0;
    }

    .docs-toc {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-surface);
    }

    .docs-toc-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text);
      cursor: pointer;
      list-style: none;
      user-select: none;
    }

    .docs-toc-summary::-webkit-details-marker {
      display: none;
    }

    .docs-toc-chevron {
      color: var(--text-muted);
      transition: transform 0.2s ease;
    }

    .docs-toc[open] .docs-toc-chevron {
      transform: rotate(180deg);
    }

    .docs-toc > .docs-nav {
      padding: 0.5rem 1rem 1rem;
      border-top: 1px solid var(--border);
      max-height: 60vh;
      overflow-y: auto;
    }

    .nav-group {
      margin-bottom: 1rem;
    }
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.nav-link[data-section]')
  const sections = Array.from(links).map(link => {
    const id = link.getAttribute('data-section')!
    return { link, el: document.getElementById(id) }
  }).filter(s => s.el)

  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        links.forEach(l => l.classList.remove('active'))
        const match = sections.find(s => s.el === entry.target)
        if (match) match.link.classList.add('active')
      }
    }
  }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 })

  sections.forEach(s => observer.observe(s.el!))

  const toc = document.querySelector<HTMLDetailsElement>('.docs-toc')
  if (toc) {
    toc.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      if (window.matchMedia('(max-width: 860px)').matches) toc.open = false
    }))
  }
</script>
