---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import Problem from '../components/Problem.astro'
import HowItWorks from '../components/HowItWorks.astro'
import Adapters from '../components/Adapters.astro'
import Integrations from '../components/Integrations.astro'
import Features from '../components/Features.astro'
import QuickStart from '../components/QuickStart.astro'
import Footer from '../components/Footer.astro'

// Keyword-led homepage title/description: lead with the search intent ("MCP servers",
// "TypeScript"), keep the brand + tagline as the trailing hook.
const title = 'Silkweave - TypeScript Toolkit for MCP Servers, REST APIs & CLI Tools'
const description =
  'Open-source TypeScript toolkit for building MCP servers, REST APIs, tRPC, and CLI tools from one set of Actions. Define once, deploy everywhere.'

// Silkweave is an open-source TypeScript library distributed on npm, so it is modeled
// as SoftwareSourceCode rather than SoftwareApplication: Google's "Software App" rich
// result requires an aggregateRating/review we have no honest data for, and a code
// toolkit is not an installable end-user app anyway.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Silkweave',
  description,
  url: 'https://www.silkweave.dev',
  codeRepository: 'https://github.com/silkweave/silkweave',
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'Node.js',
  license: 'https://github.com/silkweave/silkweave/blob/master/LICENSE',
  author: { '@type': 'Organization', name: 'Silkweave', url: 'https://github.com/silkweave' },
  sameAs: [
    'https://github.com/silkweave/silkweave',
    'https://www.npmjs.com/org/silkweave',
    'https://x.com/tstrebitzer'
  ]
}
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Nav />
  <main>
    <Hero />
    <Problem />
    <QuickStart />
    <HowItWorks />
    <Adapters />
    <Integrations />
    <Features />
  </main>
  <Footer />
</Layout>
