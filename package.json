{
  "name": "silkweave-workspace",
  "description": "Silkweave Toolkit",
  "license": "MIT",
  "homepage": "https://www.silkweave.dev",
  "bugs": {
    "url": "https://github.com/silkweave/silkweave/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/silkweave/silkweave.git"
  },
  "private": true,
  "scripts": {
    "mcp": "pnpm -F @silkweave/example-mcp stdio",
    "image": "node --env-file-if-exists=.env scripts/generate-image.ts",
    "sync-releases": "tsx scripts/sync-releases.ts",
    "indexnow": "tsx scripts/indexnow-submit.ts",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "roam": "roam index && roam fitness && roam rules --ci",
    "check": "pnpm format:check && turbo check && pnpm roam",
    "clean": "turbo clean && rimraf .turbo/cache",
    "prepack": "turbo prepack",
    "publish:all": "pnpm publish -r --access public",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.9",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.1.1"
}
