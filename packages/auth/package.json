{
  "name": "@silkweave/auth",
  "version": "3.2.0",
  "description": "Silkweave Auth - Bearer token and OAuth 2.1 support for MCP servers",
  "license": "MIT",
  "homepage": "https://www.silkweave.dev",
  "bugs": {
    "url": "https://github.com/silkweave/silkweave/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/silkweave/silkweave.git",
    "directory": "packages/auth"
  },
  "type": "module",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "@silkweave/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    },
    "./oauth": {
      "@silkweave/source": "./src/oauth.ts",
      "types": "./build/oauth.d.mts",
      "default": "./build/oauth.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@silkweave/core": "workspace:*",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.9"
  }
}
