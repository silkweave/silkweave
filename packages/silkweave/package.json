{
  "name": "silkweave",
  "version": "4.4.0",
  "description": "Silkweave CLI - install and sync agent skills from silkweave MCP servers, proxy any silkweave server as a CLI",
  "license": "MIT",
  "homepage": "https://www.silkweave.dev",
  "bugs": {
    "url": "https://github.com/silkweave/silkweave/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/silkweave/silkweave.git",
    "directory": "packages/silkweave"
  },
  "type": "module",
  "bin": {
    "silkweave": "./build/cli.mjs"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "dev": "tsx --conditions=@silkweave/source src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@silkweave/core": "workspace:*",
    "@silkweave/mcp": "workspace:*",
    "@silkweave/skills": "workspace:*",
    "commander": "^13.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.9"
  }
}
