{
  "name": "@silkweave/edge",
  "version": "5.1.0",
  "description": "Silkweave Web-Standard edge/serverless adapter (Cloudflare Workers, Vercel, Bun, Deno, Hono)",
  "license": "MIT",
  "homepage": "https://www.silkweave.dev",
  "bugs": {
    "url": "https://github.com/silkweave/silkweave/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/silkweave/silkweave.git",
    "directory": "packages/edge"
  },
  "type": "module",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "@silkweave/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@silkweave/auth": "workspace:*",
    "@silkweave/core": "workspace:*",
    "@silkweave/mcp": "workspace:*",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@silkweave/skills": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@silkweave/skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@silkweave/skills": "workspace:^",
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
