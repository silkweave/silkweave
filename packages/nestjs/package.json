{
  "name": "@silkweave/nestjs",
  "version": "5.1.0",
  "description": "Silkweave NestJS Adapter",
  "license": "MIT",
  "homepage": "https://www.silkweave.dev",
  "bugs": {
    "url": "https://github.com/silkweave/silkweave/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/silkweave/silkweave.git",
    "directory": "packages/nestjs"
  },
  "type": "module",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "@silkweave/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    },
    "./mcp": {
      "@silkweave/source": "./src/mcp.ts",
      "types": "./build/mcp.d.mts",
      "default": "./build/mcp.mjs"
    },
    "./trpc": {
      "@silkweave/source": "./src/trpc.ts",
      "types": "./build/trpc.d.mts",
      "default": "./build/trpc.mjs"
    },
    "./typegen": {
      "@silkweave/source": "./src/typegen.ts",
      "types": "./build/typegen.d.mts",
      "default": "./build/typegen.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^7.0.0 || ^8.0.0 || ^11.0.0",
    "@silkweave/mcp": "workspace:^",
    "@silkweave/trpc": "workspace:^",
    "@silkweave/typegen": "workspace:^",
    "@trpc/server": "^11.7.1",
    "class-validator": "^0.14.0 || ^0.15.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    },
    "@silkweave/mcp": {
      "optional": true
    },
    "@silkweave/trpc": {
      "optional": true
    },
    "@silkweave/typegen": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    }
  },
  "dependencies": {
    "@silkweave/core": "workspace:*",
    "change-case": "^5.4.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@silkweave/auth": "workspace:*",
    "@silkweave/mcp": "workspace:^",
    "@silkweave/trpc": "workspace:^",
    "@silkweave/typegen": "workspace:^",
    "@trpc/server": "^11.18.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
