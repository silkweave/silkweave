{
  "name": "@silkweave/nextjs",
  "version": "5.2.0",
  "description": "Silkweave Next.js App Router Adapter",
  "license": "MIT",
  "homepage": "https://www.silkweave.dev",
  "bugs": {
    "url": "https://github.com/silkweave/silkweave/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/silkweave/silkweave.git",
    "directory": "packages/nextjs"
  },
  "type": "module",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "@silkweave/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@silkweave/auth": "workspace:*",
    "@silkweave/core": "workspace:*",
    "@silkweave/edge": "workspace:*",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@silkweave/trpc": "workspace:*",
    "@trpc/server": "^11.7.1"
  },
  "peerDependenciesMeta": {
    "@silkweave/trpc": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@silkweave/trpc": "workspace:*",
    "@trpc/server": "^11.18.0",
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
