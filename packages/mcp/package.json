{
  "name": "@silkweave/mcp",
  "version": "4.4.0",
  "description": "Silkweave MCP Package",
  "license": "MIT",
  "homepage": "https://www.silkweave.dev",
  "bugs": {
    "url": "https://github.com/silkweave/silkweave/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/silkweave/silkweave.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "@silkweave/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    },
    "./server": {
      "@silkweave/source": "./src/server.ts",
      "types": "./build/server.d.mts",
      "default": "./build/server.mjs"
    },
    "./tools": {
      "@silkweave/source": "./src/tools.ts",
      "types": "./build/tools.d.mts",
      "default": "./build/tools.mjs"
    },
    "./cli-proxy": {
      "@silkweave/source": "./src/cliProxy.ts",
      "types": "./build/cliProxy.d.mts",
      "default": "./build/cliProxy.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@silkweave/auth": "workspace:*",
    "@silkweave/core": "workspace:*",
    "change-case": "^5.4.4",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@silkweave/skills": "workspace:^",
    "commander": "^13.1.0",
    "cors": "^2.8.5",
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@silkweave/skills": {
      "optional": true
    },
    "commander": {
      "optional": true
    },
    "cors": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@silkweave/skills": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "commander": "^13.1.0",
    "cors": "^2.8.6",
    "eslint": "^10.4.0",
    "express": "^5.2.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.9"
  }
}
