{
  "name": "@silkweave/mcp",
  "version": "7.1.1",
  "description": "Silkweave MCP Package",
  "license": "MIT",
  "homepage": "https://www.silkweave.dev",
  "bugs": {
    "url": "https://github.com/silkweave/silkweave/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/silkweave/silkweave.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "@silkweave/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    },
    "./server": {
      "@silkweave/source": "./src/server.ts",
      "types": "./build/server.d.mts",
      "default": "./build/server.mjs"
    },
    "./tools": {
      "@silkweave/source": "./src/tools.ts",
      "types": "./build/tools.d.mts",
      "default": "./build/tools.mjs"
    },
    "./cli-proxy": {
      "@silkweave/source": "./src/cliProxy.ts",
      "types": "./build/cliProxy.d.mts",
      "default": "./build/cliProxy.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@silkweave/auth": "workspace:*",
    "@silkweave/core": "workspace:*",
    "change-case": "^5.4.4",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@silkweave/skills": "workspace:^",
    "commander": "^13.1.0 || ^14.0.0 || ^15.0.0",
    "cors": "^2.8.5",
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@silkweave/skills": {
      "optional": true
    },
    "commander": {
      "optional": true
    },
    "cors": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.14.0",
    "@silkweave/skills": "workspace:^",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "commander": "^15.1.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "rimraf": "^6.1.4",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
