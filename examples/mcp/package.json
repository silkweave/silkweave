{
  "name": "@silkweave/example-mcp",
  "version": "1.10.0",
  "description": "Silkweave MCP adapters (stdio, http, http+auth, http+oauth, cli-proxy)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/stdio.ts",
    "stdio": "tsx src/stdio.ts",
    "http": "tsx src/http.ts",
    "http-auth": "tsx src/http-auth.ts",
    "http-oauth": "tsx src/http-oauth.ts",
    "cli-proxy": "tsx src/cli-proxy.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@silkweave/auth": "workspace:*",
    "@silkweave/core": "workspace:*",
    "@silkweave/logger": "workspace:*",
    "@silkweave/mcp": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
