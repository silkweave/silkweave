{
  "name": "@silkweave/example-mcp",
  "version": "3.2.1",
  "description": "Silkweave MCP adapters (stdio, http, http+auth, http+oauth, cli-proxy)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=@silkweave/source src/stdio.ts",
    "stdio": "tsx --conditions=@silkweave/source src/stdio.ts",
    "http": "tsx --conditions=@silkweave/source src/http.ts",
    "http-auth": "tsx --conditions=@silkweave/source src/http-auth.ts",
    "http-oauth": "tsx --conditions=@silkweave/source src/http-oauth.ts",
    "cli-proxy": "tsx --conditions=@silkweave/source src/cli-proxy.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@silkweave/auth": "workspace:*",
    "@silkweave/core": "workspace:*",
    "@silkweave/mcp": "workspace:*",
    "commander": "^13.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
