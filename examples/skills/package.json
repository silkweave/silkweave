{
  "name": "@silkweave/example-skills",
  "version": "5.0.0-rc.1",
  "description": "Silkweave skills example - serve Agent Skills over MCP, install them with the silkweave CLI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=@silkweave/source src/http.ts",
    "stdio": "tsx --conditions=@silkweave/source src/stdio.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@silkweave/core": "workspace:*",
    "@silkweave/mcp": "workspace:*",
    "@silkweave/skills": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
