{
  "name": "@silkweave/example-cli",
  "version": "4.2.0",
  "description": "Silkweave CLI adapter example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=@silkweave/source src/cli.ts",
    "umbrella": "tsx --conditions=@silkweave/source src/umbrella.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@silkweave/cli": "workspace:*",
    "@silkweave/core": "workspace:*",
    "silkweave": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
