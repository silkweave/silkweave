{
  "name": "@silkweave/example-nestjs",
  "version": "3.2.0",
  "description": "Silkweave NestJS adapter example (expose existing controllers as MCP tools via @Mcp and tRPC procedures via @Trpc)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=@silkweave/source --import @swc-node/register/esm-register src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@silkweave/core": "workspace:*",
    "@silkweave/mcp": "workspace:*",
    "@silkweave/nestjs": "workspace:*",
    "@silkweave/trpc": "workspace:*",
    "@silkweave/typegen": "workspace:*",
    "@trpc/server": "^11.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc-node/register": "^1.11.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
