{
  "name": "@silkweave/example-ai",
  "version": "5.2.2",
  "description": "Silkweave + Vercel AI SDK + tRPC subscriptions chat example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch --conditions=@silkweave/source --tsconfig tsconfig.server.json server/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "oxlint",
    "check": "pnpm typecheck"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/react": "^4.0.169",
    "@silkweave/ai": "workspace:*",
    "@silkweave/core": "workspace:*",
    "@silkweave/trpc": "workspace:*",
    "@trpc/client": "^11.25.0",
    "@trpc/server": "^11.25.0",
    "ai": "^7.0.165",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.9",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
