{
  "mcpServers": {
    "silkweave": {
      "command": "pnpm",
      "args": ["mcp"]
    },
    "roam-code": {
      "type": "stdio",
      "command": "roam",
      "args": ["mcp"]
    },
    "lighthouse": {
      "command": "npx",
      "args": ["@danielsogl/lighthouse-mcp"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"]
    }
  }
}
